---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Registro y auditoría de Trabajo Profundo (Cal Newport) con indicadores de salud y ritual de cierre diario" } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-[#090C10] text-slate-100 min-h-screen selection:bg-pastel-lavender/30 selection:text-pastel-lavender antialiased relative overflow-x-hidden">
    <!-- Ambient subtle glows in background -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-pastel-lavender/5 blur-[120px] rounded-full"></div>
      <div class="absolute top-[40%] -left-32 w-[450px] h-[450px] bg-pastel-ice/5 blur-[140px] rounded-full"></div>
      <div class="absolute bottom-10 -right-32 w-[500px] h-[400px] bg-pastel-mint/5 blur-[150px] rounded-full"></div>
    </div>

    <!-- Main Application Container -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
