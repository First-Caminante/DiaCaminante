---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Sistema de Foco y Filosofía Diaria. Registro de sesiones de trabajo profundo y reflexiones." } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,400;1,600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-[#070e1e] text-[#f8fafc] min-h-screen selection:bg-[#3b82f6]/30 selection:text-[#f8fafc] antialiased relative overflow-x-hidden font-sans">
    <!-- Resplandor ambiental etéreo azul medianoche y dorado suave -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
      <div class="absolute -top-32 left-1/3 w-[800px] h-[500px] bg-[#1d3557]/25 blur-[160px] rounded-full"></div>
      <div class="absolute top-[35%] -left-40 w-[600px] h-[600px] bg-[#0f1d3b]/35 blur-[180px] rounded-full"></div>
      <div class="absolute bottom-10 -right-40 w-[650px] h-[650px] bg-[#e5c179]/10 blur-[200px] rounded-full"></div>
    </div>

    <!-- Main Application Container -->
    <div class="relative z-10 flex min-h-screen">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
